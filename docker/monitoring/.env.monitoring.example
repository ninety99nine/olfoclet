# Grafana Cloud credentials for Alloy remote_write (Phase 10).
# Copy to .env.monitoring and fill in. Get these from your Grafana Cloud stack:
#   Home > Connections > Data sources > (Prometheus / Loki) > "Details".
# Keep .env.monitoring OUT of git.

TELCOFLO_ENV=staging

# ---- Prometheus (Mimir) remote_write --------------------------------------
GRAFANA_CLOUD_PROM_URL=https://prometheus-prod-XX-<region>.grafana.net/api/prom/push
GRAFANA_CLOUD_PROM_USER=<prometheus-instance-id>
GRAFANA_CLOUD_PROM_PASSWORD=<grafana-cloud-api-token>

# ---- Loki (logs — only needed if you enable the log section in config.alloy)
GRAFANA_CLOUD_LOKI_URL=https://logs-prod-XX.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_USER=<loki-instance-id>
GRAFANA_CLOUD_LOKI_PASSWORD=<grafana-cloud-api-token>

# ---- mysqld-exporter DB password (must match the exporter user) -----------
MONITORING_DB_PASSWORD=exporter
