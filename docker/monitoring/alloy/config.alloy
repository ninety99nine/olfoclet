// Telcoflo V1 — Grafana Alloy config (Phase 10).
// Scrapes the local exporters and remote_writes metrics to Grafana Cloud.
// Credentials come from .env.monitoring (see .env.monitoring.example).

// ---- Scrape the exporters -------------------------------------------------
prometheus.scrape "telcoflo" {
  scrape_interval = "15s"
  targets = [
    { __address__ = "node-exporter:9100",   job = "node",    instance = "telcoflo-v1" },
    { __address__ = "php-fpm-exporter:9253", job = "php-fpm", instance = "telcoflo-v1" },
    { __address__ = "mysqld-exporter:9104",  job = "mysql",   instance = "telcoflo-v1" },
    { __address__ = "nginx-exporter:9113",   job = "nginx",   instance = "telcoflo-v1" },
  ]
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

// ---- Push metrics to Grafana Cloud (Mimir) --------------------------------
prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_PROM_URL")
    basic_auth {
      username = sys.env("GRAFANA_CLOUD_PROM_USER")
      password = sys.env("GRAFANA_CLOUD_PROM_PASSWORD")
    }
  }
  // Tag everything so panels can filter to this stack.
  external_labels = {
    stack = "telcoflo-v1",
    env   = sys.env("TELCOFLO_ENV"),
  }
}

// ---- Logs (optional) ------------------------------------------------------
// Ships container stdout/stderr (the app logs to stderr) to Grafana Cloud Loki,
// so you can line error timestamps up against the metric spikes. Requires
// mounting /var/run/docker.sock into the alloy container (see the compose file).
//
