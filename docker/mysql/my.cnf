[mysqld]
# MySQL tuning — report §6. innodb_buffer_pool_size should be 60-70% of the
# box's RAM on the real Orange server (report suggests ~5G). Kept modest here so
# the container starts anywhere; RAISE IT for load testing (Phase 10) so the
# buffer-pool hit rate mirrors production.
innodb_buffer_pool_size        = 1G
innodb_buffer_pool_instances   = 4
innodb_log_file_size           = 256M
# 2 = flush once per second: a good durability/throughput balance for USSD
# (report §6). 1 is fully ACID but slower; 0 is fastest but riskiest.
innodb_flush_log_at_trx_commit = 2
innodb_flush_method            = O_DIRECT

# WRITE-PATH TUNING (Phase 10). The engine writes ussd_sessions on every step,
# so commit-time fsync is on the hot path. Binary logging isn't needed on this
# staging/load-test replica (no replication / PITR), so sync_binlog=0 removes a
# per-commit fsync stall — this alone cut p95 from ~2.0s to ~1.4s at 150
# concurrent users. NOTE for the REAL Orange prod box: if binlog is required for
# replication/PITR, weigh sync_binlog=1 (durable, slower) vs 0 + solid backups.
sync_binlog                    = 0

# gp3 EBS sustains far more than the default 200; let InnoDB flush faster.
innodb_io_capacity             = 1000
innodb_io_capacity_max         = 2000

max_connections                = 500
thread_cache_size              = 100
wait_timeout                   = 60
interactive_timeout            = 60

# Slow-query visibility. At 0.1s + log-not-using-indexes, a load run writes
# thousands of log lines (observer overhead that skews results). Keep 2s here
# and log only genuinely slow statements; drop to 0.1 + enable the not-using-
# indexes log ONLY for a targeted, low-load query hunt.
slow_query_log                 = 1
slow_query_log_file            = /var/log/mysql/slow.log
long_query_time                = 2
log_queries_not_using_indexes  = 0
