# Telcoflo V1 — production/staging .env (paste into the GitHub secret PRODUCTION_ENV).
# The deploy workflow writes this verbatim to /var/www/telcoflo-v1/.env on the EC2.
# Generate a fresh APP_KEY (php artisan key:generate --show) and set real passwords.

APP_NAME=TelcofloV1
APP_ENV=production
APP_KEY=base64:CHANGE_ME
APP_DEBUG=false
APP_URL=http://<ec2-public-dns-or-domain>

LOG_CHANNEL=stderr
LOG_LEVEL=info

# ---- Database (the compose interpolates these for the mysql container too) ----
# DB_USERNAME must NOT be "root" (MySQL rejects it as MYSQL_USER).
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=telcoflo
DB_USERNAME=telcoflo
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME

# ---- Redis-backed cache / session / queue ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CLIENT=phpredis
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# ---- Orange integrations ----
# Real deploy: point at the reachable Orange hosts (public IP if the box is
# outside their network). Staging/load-test with --profile staging: point at the
# mock, e.g. http://192.168.22.202/stk/push and CMS via the mock's 192.168.22.202.
ORANGE_STK_PUSH_URL=http://192.168.22.202/stk/push

# ---- First-boot converter (File 03) ----
# Set true the first time a legacy DB dump is restored, then back to false.
RUN_UPGRADE_BUILDERS=false

# ---- TLS (promotion step — only when using docker-compose.tls.yaml) ----
# Point APP_DOMAIN's DNS at the EC2, then run docker/scripts/init-letsencrypt.sh
# and set the repo variable TLS_ENABLED=true so deploys keep HTTPS.
APP_DOMAIN=
ACME_EMAIL=
